<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order">
        <!-- Set to 1 when the order is successfully captured in TaxCloud. Read on cancel to
             decide whether to reverse the sale, so the cancel flow does not depend on the
             license-gated OrderDetails API. -->
        <column xsi:type="smallint" name="taxcloud_captured" unsigned="true" nullable="true"
                identity="false" default="0" comment="Order captured in TaxCloud"/>
        <!-- The exemption certificate that untaxed this order, if any. -->
        <column xsi:type="varchar" name="taxcloud_certificate_id" length="64" nullable="true"
                comment="TaxCloud exemption certificate applied to this order"/>
        <!-- What that certificate SAID at the time of the sale, not what it says
             now. TaxCloud stores neither the certificate document nor an expiry
             date - their documentation is explicit that both stay the merchant's
             responsibility - and a certificate can be deleted outright. So the
             identifier alone is a pointer into a store that may not contain the
             target when an auditor asks why this sale was untaxed. Written once,
             when the exemption is applied, and never revised afterwards: the
             question it answers is what was relied on, which cannot change. -->
        <column xsi:type="text" name="taxcloud_certificate_snapshot" nullable="true"
                comment="Certificate detail as it stood when this order was placed"/>
        <!-- Colorado Retail Delivery Fee, snapshotted from config at collect
             time. Stored on every document because the config value changes
             every July 1: capture and refunds must use what was charged, never
             a later config read. Kept separate from tax/shipping totals for
             reconciliation against TaxCloud's CO RDF return. -->
        <column xsi:type="decimal" name="taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee charged on this order"/>
        <column xsi:type="decimal" name="base_taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee charged on this order (base currency)"/>
        <!-- How much of TaxCloud this order uses (report / calculate_only / skip),
             decided once when the order is placed by the order processing rules
             or the store view's "Report orders to TaxCloud" default. NULL for
             orders placed before rules existed, which follow the store setting. -->
        <column xsi:type="varchar" name="taxcloud_outcome" length="32" nullable="true"
                comment="TaxCloud order processing outcome"/>
        <!-- The rule that decided the outcome; NULL when the store default did.
             No foreign key: deleting a rule must not touch order history. -->
        <column xsi:type="int" name="taxcloud_outcome_rule_id" unsigned="true" nullable="true"
                comment="TaxCloud order processing rule that decided the outcome"/>
        <!-- The rule's name when it decided, kept so the reason survives the rule. -->
        <column xsi:type="varchar" name="taxcloud_outcome_rule_name" length="255" nullable="true"
                comment="Name of the TaxCloud order processing rule that decided the outcome"/>
    </table>

    <!--
      Order processing rules: an ordered list, first active match wins. The
      filter columns hold JSON arrays (empty = any); rules are few and matched
      in PHP, never queried by filter in SQL, so link tables would add nothing.
    -->
    <table name="taxcloud_order_rule" resource="default" engine="innodb" comment="TaxCloud order processing rules">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="true" comment="Rule ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Name"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is active"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Evaluation order"/>
        <column xsi:type="varchar" name="action" length="32" nullable="false" comment="report / calculate_only / skip"/>
        <column xsi:type="text" name="store_ids" nullable="true" comment="JSON store view IDs"/>
        <column xsi:type="text" name="customer_group_ids" nullable="true" comment="JSON customer group IDs"/>
        <column xsi:type="text" name="payment_methods" nullable="true" comment="JSON payment method codes"/>
        <column xsi:type="text" name="shipping_methods" nullable="true" comment="JSON shipping method codes"/>
        <column xsi:type="text" name="order_prefixes" nullable="true" comment="JSON order number prefixes"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
        </constraint>
        <index referenceId="TAXCLOUD_ORDER_RULE_SORT_ORDER" indexType="btree">
            <column name="sort_order"/>
        </index>
    </table>
    <table name="quote_address">
        <column xsi:type="decimal" name="taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee charged on this address"/>
        <column xsi:type="decimal" name="base_taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee charged on this address (base currency)"/>
    </table>

    <table name="sales_invoice">
        <column xsi:type="decimal" name="taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee settled by this invoice"/>
        <column xsi:type="decimal" name="base_taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee settled by this invoice (base currency)"/>
    </table>

    <table name="sales_creditmemo">
        <column xsi:type="decimal" name="taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee refunded by this credit memo"/>
        <column xsi:type="decimal" name="base_taxcloud_rdf_amount" scale="4" precision="20" nullable="true"
                comment="Colorado Retail Delivery Fee refunded by this credit memo (base currency)"/>
    </table>

</schema>
