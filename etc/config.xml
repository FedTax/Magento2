<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
  <default>
    <tax>
      <taxcloud_settings>
        <enabled>0</enabled>
        <logging>1</logging>
        <verify_address>1</verify_address>
        <api_type>rest</api_type>
        <guest_customer_id>-1</guest_customer_id>
        <!-- Off until a merchant deliberately enables it: see system.xml. -->
        <exemptions_enabled>0</exemptions_enabled>
        <default_tic>00000</default_tic>
        <shipping_tic>11010</shipping_tic>
        <cache_lifetime>86400</cache_lifetime>
        <api_timeout>10</api_timeout>
        <wsdl_url>https://api.taxcloud.net/1.0/TaxCloud.asmx?wsdl</wsdl_url>
        <rest_endpoint>https://api.v3.taxcloud.com</rest_endpoint>
        <rest_auth_endpoint>https://taxcloudapi-appservice-core-prod.azurewebsites.net</rest_auth_endpoint>
        <fallback_to_magento>0</fallback_to_magento>
        <calculations_only>0</calculations_only>
        <capture_trigger>order_creation</capture_trigger>
      </taxcloud_settings>
    </tax>
    <!--
      Sibling of core's tax/notification/* section, and used the same way: the
      documentation link the admin collector notification points at, plus the
      acknowledged-conflict fingerprint the dismissal link writes. The
      acknowledgement has no default and no system.xml field on purpose — it is
      written by \Taxcloud\Magento2\Controller\Adminhtml\Notification\Ignore
      and by nothing else.
    -->
    <taxcloud>
      <notification>
        <info_url>https://fedtax.github.io/Magento2/extension-conflicts/</info_url>
      </notification>
    </taxcloud>
  </default>
</config>
