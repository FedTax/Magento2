<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/pdf_file.xsd">
    <totals>
        <!-- Between shipping (400) and grand total (600), zero suppressed:
             a printed document mirrors the on-screen totals exactly. -->
        <total name="taxcloud_rdf">
            <title translate="true">Colorado Retail Delivery Fee</title>
            <source_field>taxcloud_rdf_amount</source_field>
            <font_size>7</font_size>
            <display_zero>false</display_zero>
            <sort_order>450</sort_order>
        </total>
    </totals>
</config>
