<!--
  Adobe Commerce Admin Actions Log. Read only by Magento_Logging, which ships
  with Adobe Commerce; Magento Open Source ignores this file. The export is also
  recorded in var/log/system.log on every edition (DiagnosticsAudit).
-->
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="taxcloud_diagnostics">
            <label translate="true">TaxCloud Diagnostics</label>
            <events>
                <event controller_action="taxcloud_diagnostics_export"
                       action_alias="export"
                       post_dispatch="Taxcloud\Magento2\Model\Diagnostics\Bundle\Audit\ActionLogHandler::postDispatchExport"/>
            </events>
        </group>
    </groups>
</logging>
