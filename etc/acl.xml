<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Customer::customer">
                    <!--
                        Its own resource rather than being implied by "can edit
                        customers", because it is not an ordinary customer
                        field: a certificate exempts a sale from tax, and the
                        TaxCloud identity decides which certificates a customer
                        resolves. Granting it is granting the ability to stop
                        collecting tax from someone.
                    -->
                    <resource id="Taxcloud_Magento2::certificates"
                              title="TaxCloud Exemption Certificates"
                              translate="title"
                              sortOrder="100"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
