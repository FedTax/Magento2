<!--
  The Colorado Retail Delivery Fee is carried from quote to order by
  Observer\Sales\PersistRetailDeliveryFee, NOT by a fieldset: core's
  Quote\Address\ToOrder::convert() runs the sales_convert_quote_address
  fieldset through populateWithArray(..., OrderInterface::class), which keeps
  only interface-declared keys and drops a plain custom column. The observer
  fires on the same conversion with both entities in hand and writes the
  column directly. No fieldset entry would take effect here, so none is
  declared.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global"/>
</config>
