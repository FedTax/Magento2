<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

  <!--
    fileName is the module's default log target, relative to the Magento base
    directory. Operators can redirect TaxCloud logging by re-declaring this
    argument in their own di.xml — see README "Changing the log file location".
  -->
  <type name="Taxcloud\Magento2\Logger\Handler">
    <arguments>
      <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
      <argument name="fileName" xsi:type="string">/var/log/taxcloud.log</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Logger\Logger">
    <arguments>
      <argument name="name" xsi:type="string">tclogger</argument>
      <argument name="handlers" xsi:type="array">
        <item name="system" xsi:type="object">Taxcloud\Magento2\Logger\Handler</item>
      </argument>
    </arguments>
  </type>

  <preference for="Magento\Tax\Model\Sales\Total\Quote\Tax" type="Taxcloud\Magento2\Model\Tax" />

  <!--
    The encryptor parameter is optional (unit tests construct the config
    reader without one), and Magento's ObjectManager resolves optional
    constructor parameters to their DEFAULT, never by auto-wiring — so
    without this explicit argument the production instance gets a null
    encryptor and getRestApiKey() returns the stored ciphertext, which the
    v3 API rejects with 401.
  -->
  <type name="Taxcloud\Magento2\Model\Config\TaxcloudConfig">
    <arguments>
      <argument name="encryptor" xsi:type="object">Magento\Framework\Encryption\EncryptorInterface</argument>
    </arguments>
  </type>

  <!--
    Reverse the TaxCloud sale when an order is cancelled. registerCancellation()
    is the one method every cancellation path reaches, so this is the whole of
    the module's cancellation wiring.
  -->
  <type name="Magento\Sales\Model\Order">
    <plugin name="taxcloud_order_cancellation"
            type="Taxcloud\Magento2\Plugin\Sales\OrderCancellation"
            sortOrder="10"/>
  </type>
  <type name="Taxcloud\Magento2\Model\Order\CancellationProcessor">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>

  <!--
    Bind the TaxCloud gateway contracts to the store-aware router, which
    dispatches each call to the transport selected by the api_type setting of
    the entity's store. Consumers type-hint the finer-grained interface they
    need and stay transport-unaware; adding REST tax operations only changes
    the router's target wiring, never a call site.
  -->
  <preference for="Taxcloud\Magento2\Api\GatewayInterface" type="Taxcloud\Magento2\Model\Gateway\Router" />
  <preference for="Taxcloud\Magento2\Api\LookupGatewayInterface" type="Taxcloud\Magento2\Model\Gateway\Router" />
  <preference for="Taxcloud\Magento2\Api\OrderGatewayInterface" type="Taxcloud\Magento2\Model\Gateway\Router" />
  <preference for="Taxcloud\Magento2\Api\AddressGatewayInterface" type="Taxcloud\Magento2\Model\Gateway\Router" />
  <preference for="Taxcloud\Magento2\Api\ExemptionGatewayInterface" type="Taxcloud\Magento2\Model\Gateway\Router" />

  <!-- SOAP transport is the default client provider for the gateway. -->
  <preference for="Taxcloud\Magento2\Model\Gateway\Soap\SoapClientProviderInterface"
              type="Taxcloud\Magento2\Model\Gateway\Soap\SoapGateway" />

  <!--
    Hand every gateway collaborator the config-gated logger so TaxCloud logging
    respects the store's "logging" setting instead of each class re-deriving it.
  -->
  <type name="Taxcloud\Magento2\Model\Gateway\Soap\SoapGateway">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\RetryPolicy">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\ResponseMapper">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\RequestBuilder">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\ExemptionValidator">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
      <argument name="cacheType" xsi:type="object">Taxcloud\Magento2\Model\Cache\Type\Taxcloud</argument>
    </arguments>
  </type>

  <!--
    REST transport collaborators: the same config-gated logger discipline as
    their SOAP counterparts, and the module's own cache type for the
    exemption-state cache.
  -->
  <type name="Taxcloud\Magento2\Model\Gateway\Rest\RestGateway">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>

  <!--
    The router receives the REST gateway as a proxy: a store fleet that never
    selects "V3 REST" never instantiates the REST stack (auth provider, token
    cache, curl client).
  -->
  <type name="Taxcloud\Magento2\Model\Gateway\Router">
    <arguments>
      <argument name="rest" xsi:type="object">Taxcloud\Magento2\Model\Gateway\Rest\RestGateway\Proxy</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\Rest\RestRequestBuilder">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\Rest\RestResponseMapper">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\Rest\RestExemptionValidator">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
      <argument name="cacheType" xsi:type="object">Taxcloud\Magento2\Model\Cache\Type\Taxcloud</argument>
    </arguments>
  </type>

  <!--
    Every TaxCloud cache write goes through the module's own cache type, so
    System → Cache Management can flush TaxCloud entries on their own.
    Magento\Framework\Cache\FrontendInterface has no global preference, so these
    bindings are what resolve it — a missing one fails loudly at compile time
    rather than silently falling back to another frontend.
  -->
  <type name="Taxcloud\Magento2\Model\Cache\ResultCache">
    <arguments>
      <argument name="cacheType" xsi:type="object">Taxcloud\Magento2\Model\Cache\Type\Taxcloud</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Gateway\Rest\TokenCache">
    <arguments>
      <argument name="cacheType" xsi:type="object">Taxcloud\Magento2\Model\Cache\Type\Taxcloud</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\Tic\TicCache">
    <arguments>
      <argument name="cacheType" xsi:type="object">Taxcloud\Magento2\Model\Cache\Type\Taxcloud</argument>
    </arguments>
  </type>

  <!--
    TIC lookup follows the gateway's own rule: the store's api_type decides
    which API answers, so the picker can never disagree with the transport the
    same store transacts over. Both backends are proxied, so a fleet that only
    ever selects one API never builds the other's stack.
  -->
  <preference for="Taxcloud\Magento2\Api\TicLookupInterface"
              type="Taxcloud\Magento2\Model\Tic\TicLookupRouter" />
  <type name="Taxcloud\Magento2\Model\Tic\TicLookupRouter">
    <arguments>
      <argument name="soap" xsi:type="object">Taxcloud\Magento2\Model\Tic\SoapTicLookup\Proxy</argument>
      <argument name="rest" xsi:type="object">Taxcloud\Magento2\Model\Tic\RestTicLookup\Proxy</argument>
    </arguments>
  </type>

  <type name="Magento\Framework\Console\CommandList">
    <arguments>
      <argument name="commands" xsi:type="array">
        <item name="taxcloud_migrate_credentials" xsi:type="object">Taxcloud\Magento2\Console\Command\MigrateCredentialsCommand</item>
      </argument>
    </arguments>
  </type>

  <type name="Taxcloud\Magento2\Model\Fallback\MagentoTaxFallback">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\ProductTicService">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Model\CategoryTicResolver">
    <arguments>
      <argument name="logger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>

  <!--
    The tax collector and the observers take the same config-gated proxy. The
    argument is named tclogger here rather than logger, matching those
    constructors.
  -->
  <type name="Taxcloud\Magento2\Model\Tax">
    <arguments>
      <argument name="tclogger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Observer\Sales\Address">
    <arguments>
      <argument name="tclogger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Observer\Sales\Complete">
    <arguments>
      <argument name="tclogger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>
  <type name="Taxcloud\Magento2\Observer\Sales\Refund">
    <arguments>
      <argument name="tclogger" xsi:type="object">Taxcloud\Magento2\Model\Logging\GatewayLogger</argument>
    </arguments>
  </type>

</config>
