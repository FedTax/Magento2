# Integration test environment template.
# Copy to .env and fill in your values. .env is gitignored.
#
#   cp .env.example .env
#   $EDITOR .env
#   make integration-test
#
# CI does not read this file — secrets are injected via GitHub Actions secrets.

# ---------------------------------------------------------------------------
# TaxCloud sandbox credentials.
# Grab a free pair from the TaxCloud sandbox: https://taxcloud.com/sandbox
# (sandbox keys never charge real tax)
# ---------------------------------------------------------------------------
TAXCLOUD_API_ID=
TAXCLOUD_API_KEY=

# ---------------------------------------------------------------------------
# Magento Marketplace public/private keys.
# Required for BOTH editions when installing from repo.magento.com.
# Free signup: https://commercemarketplace.adobe.com/customer/accessKeys/
# ---------------------------------------------------------------------------
MAGENTO_PUBLIC_KEY=
MAGENTO_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Magento edition + version under test. Overridable via make targets:
#   make integration-test MAGENTO_EDITION=enterprise MAGENTO_VERSION=2.4.8-p5 PHP_VERSION=8.3
# ---------------------------------------------------------------------------
MAGENTO_EDITION=community
MAGENTO_VERSION=2.4.8-p5
PHP_VERSION=8.3

# ---------------------------------------------------------------------------
# Stack service versions. Normally LEAVE THESE UNSET -- the install script
# derives them from MAGENTO_VERSION per Adobe's system requirements
# (<=2.4.8: MariaDB 10.6 / OpenSearch 2.12; >=2.4.9: MariaDB 11.4 /
# OpenSearch 3.0). Set them only to test a non-default combination.
# ---------------------------------------------------------------------------
# MARIADB_VERSION=
# OPENSEARCH_VERSION=

# ---------------------------------------------------------------------------
# Where the Magento install lives on disk.
# Defaults to a peer directory of this module: ../magento-<edition>-<version>.
# Set this if you want it elsewhere — e.g. an existing Magento install you'd
# like to reuse. Must be an absolute path or a path relative to this repo root.
# ---------------------------------------------------------------------------
# MAGENTO_INSTALL_DIR=

# ---------------------------------------------------------------------------
# E2E (Playwright) tests — see docs/E2E_TESTS.md.
# These are ONLY used by `make e2e-*` (and the e2e-tests workflow); the
# integration suite ignores them. The same one-time .env edit above (TaxCloud +
# Marketplace keys) is all you need — these have working defaults.
#
# Under E2E mode the install script overlays docker-compose.e2e.yml, which runs
# php-fpm + an nginx container that publishes the storefront on the host so the
# browser can reach it.
# ---------------------------------------------------------------------------
# Host port nginx publishes the storefront on. Change it if 8080 is taken (e.g.
# by a Warden / other local stack). Keep it in sync with MAGENTO_BASE_URL.
# MAGENTO_HTTP_PORT=8080

# Base URL Magento is installed with AND that Playwright points at. Must match
# MAGENTO_HTTP_PORT and end in a slash. Defaults to http://localhost:8080/.
# MAGENTO_BASE_URL=http://localhost:8080/

# Run the browser headed (visible) instead of headless. Handy for local
# debugging; leave false in CI.
# PLAYWRIGHT_HEADED=false

# Number of parallel Playwright workers. Kept at 1 by default because the tests
# share one Magento DB — concurrent checkouts/orders would collide.
# PLAYWRIGHT_WORKERS=1
