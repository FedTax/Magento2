<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <!--
              The link is hidden by the same policy that guards the page, so a
              customer is never offered a menu item that answers with a 404.
            -->
            <block class="Taxcloud\Magento2\Block\Certificate\NavigationLink"
                   name="customer-account-navigation-taxcloud-certificates">
                <arguments>
                    <argument name="path" xsi:type="string">taxcloud/certificate</argument>
                    <argument name="label" xsi:type="string" translate="true">Tax Exemption Certificates</argument>
                    <argument name="sortOrder" xsi:type="number">175</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
