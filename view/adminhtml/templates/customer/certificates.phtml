<?php
/**
 * Taxcloud_Magento2 - exemption certificates on the customer edit page.
 *
 * Field markup follows the admin's own conventions (admin__fieldset /
 * admin__field / admin__field-label) so the panel reads as part of the customer
 * page rather than something bolted onto it.
 *
 * @var \Taxcloud\Magento2\Block\Adminhtml\Customer\Edit\Tab\Certificates $block
 * @var \Magento\Framework\Escaper $escaper
 */
if (!$block->canManageCertificates()) {
    return;
}
$options = $block->getFormOptions();
$states = $block->getUsStates();
$guidance = $block->getGuidanceUrl();
?>
<?php
/*
 * This panel is tab content: knockout injects it after Magento's bootstrap has
 * already collected the x-magento-init scripts present at parse time, and the
 * stock htmlContent template renders through knockout's native `html` binding,
 * which never calls mage.apply(). Both standard init routes therefore land in
 * the DOM inert — verified, twice, by a panel that rendered perfectly and made
 * no requests at all.
 *
 * So the config rides on an attribute of our own and
 * js/certificate/tab-bootstrap.js initialises the panel when it appears. A
 * dedicated attribute rather than data-mage-init on purpose: if a future
 * Magento does apply injected content, data-mage-init would give two live
 * instances of this panel, each issuing its own writes.
 */
?>
<section class="admin__page-section taxcloud-certificates" data-taxcloud-certificates
         data-taxcloud-config="<?= $escaper->escapeHtmlAttr($block->getJsConfig()) ?>">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('TaxCloud Exemption Certificates')) ?></span>
    </div>

    <div class="admin__page-section-content">
        <div class="admin__field-note">
            <?= $escaper->escapeHtml(__(
                'Certificates are held by TaxCloud, not by Magento. This shows what the account used by %1 holds for this customer. Exemptions apply to US destinations only.',
                $block->getStoreLabel()
            )) ?>
        </div>

        <div data-role="status"></div>

        <!--
          The lookup identity. Written by the JS once the listing returns,
          because what it needs to SAY depends on whether it is the default:
          on most customers this is unremarkable and stays quiet, and it only
          becomes prominent when someone has pointed this customer somewhere
          else. Filled in rather than rendered here so the two cases can read
          differently instead of both showing a bare number.
        -->
        <div class="admin__field-note" data-role="identity-line"></div>

        <!-- Wrapper exists so the loader can span the table area rather than
             covering the whole page: refreshing re-reads this list and nothing
             else, and the spinner should say so. -->
        <div data-role="table-region" style="position: relative;">
        <table class="admin__table-primary" data-role="certificate-table" style="display:none;">
            <thead>
            <tr>
                <th><?= $escaper->escapeHtml(__('Certificate')) ?></th>
                <th><?= $escaper->escapeHtml(__('Applies in')) ?></th>
                <th><?= $escaper->escapeHtml(__('Issued to')) ?></th>
                <th><?= $escaper->escapeHtml(__('Reason')) ?></th>
                <th><?= $escaper->escapeHtml(__('In use')) ?></th>
                <th><?= $escaper->escapeHtml(__('Action')) ?></th>
            </tr>
            </thead>
            <tbody data-role="certificate-rows"></tbody>
        </table>

        <!--
          The admin's own grid spinner, not mage/loader. Same markup every UI
          grid uses, so it reads as part of the page instead of introducing a
          third loader style; its styles ship with the admin theme and it needs
          the positioned ancestor above to sit over the table.
        -->
        <div data-role="spinner" class="admin__data-grid-loading-mask" style="display: none;">
            <div class="spinner">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
            </div>
        </div>
        </div>

        <div class="admin__field admin__field-complex">
            <button type="button" class="action-secondary" data-role="refresh">
                <?= $escaper->escapeHtml(__('Refresh from TaxCloud')) ?>
            </button>
            <button type="button" class="action-secondary" data-role="show-add">
                <?= $escaper->escapeHtml(__('Add Certificate')) ?>
            </button>
        </div>

        <!--
          A real form element, so Magento's own validation applies rather than
          a `required` class that only looks like a rule. Verified safe: this
          panel renders outside the customer edit form, so there is no nesting.
          The required-entry classes below mirror CertificateFormReader
          exactly — client and server must agree, or one of them is lying.
        -->
        <form data-role="add-form" id="tc_cert_form" action="#" method="post" style="display:none;">
        <fieldset class="admin__fieldset">
            <legend class="admin__legend">
                <span><?= $escaper->escapeHtml(__('New exemption certificate')) ?></span>
            </legend>
            <br>

            <div class="admin__field-note">
                <?= $escaper->escapeHtml(__(
                    'This certificate will apply to all of this customer\'s future orders shipped to the states you choose. TaxCloud does not verify exemption claims and does not keep the signed certificate — retain your copy.'
                )) ?>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_states">
                    <span><?= $escaper->escapeHtml(__('Applies in')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="tc_cert_states" class="admin__control-multiselect required-entry" multiple size="8"
                            name="tc_states" data-field="states">
                        <?php foreach ($states as $code => $name): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($code) ?>"><?= $escaper->escapeHtml($name) ?></option>
                        <?php endforeach; ?>
                    </select>
                    <div class="admin__field-note">
                        <button type="button" class="action-secondary" data-role="states-all">
                            <?= $escaper->escapeHtml(__('Select all states')) ?>
