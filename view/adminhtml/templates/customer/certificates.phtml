            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_reason">
                    <span><?= $escaper->escapeHtml(__('Reason for exemption')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="tc_cert_reason" class="admin__control-select" data-field="reason">
                        <?php foreach ($options['reasons'] as $value => $label): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($value) ?>"><?= $escaper->escapeHtml($label) ?></option>
                        <?php endforeach; ?>
                    </select>
                    <div class="admin__field-note">
                        <?= $escaper->escapeHtml(__('Not sure which applies?')) ?>
                        <a href="<?= $escaper->escapeUrl($guidance) ?>" target="_blank" rel="noopener noreferrer">
                            <?= $escaper->escapeHtml(__('TaxCloud\'s guidance on exemption certificates')) ?>
                        </a>
                    </div>
                </div>
            </div>

            <div class="admin__field">
                <label class="admin__field-label" for="tc_cert_reasondesc">
                    <span><?= $escaper->escapeHtml(__('Description (optional)')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input id="tc_cert_reasondesc" class="admin__control-text" data-field="reasonDescription"
                           maxlength="<?= (int) $block->getReasonDescriptionLimit() ?>"/>
                    <div class="admin__field-note">
                        <?= $escaper->escapeHtml(__(
                            'Your own note about this exemption, up to %1 characters. Leave it blank if the reason above says enough.',
                            $block->getReasonDescriptionLimit()
                        )) ?>
                    </div>
                </div>
            </div>

            <div class="admin__field admin__field-complex">
                <button type="button" class="action-primary" data-role="save">
                    <?= $escaper->escapeHtml(__('Create Certificate')) ?>
