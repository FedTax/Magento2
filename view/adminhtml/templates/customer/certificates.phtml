                    </div>
                    <div class="admin__field-note">
                        <?= $escaper->escapeHtml(__(
                            'Choose every state this certificate covers — TaxCloud records the list but does not enforce it, so this is what decides where the exemption applies.'
                        )) ?>
                    </div>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_firstname">
                    <span><?= $escaper->escapeHtml(__('Purchaser name')) ?></span>
                </label>
                <div class="admin__field-control admin__control-grouped">
                    <div class="admin__field">
                        <input id="tc_cert_firstname" class="admin__control-text required-entry" name="tc_firstname" data-field="firstName"
                               placeholder="<?= $escaper->escapeHtmlAttr(__('First name')) ?>"/>
                    </div>
                    <div class="admin__field">
                        <input class="admin__control-text required-entry" name="tc_lastname" data-field="lastName"
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Last name')) ?>"/>
                    </div>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_address1">
                    <span><?= $escaper->escapeHtml(__('Street address')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input id="tc_cert_address1" class="admin__control-text required-entry" name="tc_address1" data-field="address1"/>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_city">
                    <span><?= $escaper->escapeHtml(__('City')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input id="tc_cert_city" class="admin__control-text required-entry" name="tc_city" data-field="city"/>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_state">
                    <span><?= $escaper->escapeHtml(__('State')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="tc_cert_state" class="admin__control-select required-entry" name="tc_state" data-field="state">
                        <option value=""><?= $escaper->escapeHtml(__('Please select')) ?></option>
                        <?php foreach ($states as $code => $name): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($code) ?>"><?= $escaper->escapeHtml($name) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_zip">
                    <span><?= $escaper->escapeHtml(__('ZIP')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input id="tc_cert_zip" class="admin__control-text required-entry" name="tc_zip" data-field="zip"/>
                </div>
            </div>

            <div class="admin__field required">
                <label class="admin__field-label" for="tc_cert_businesstype">
                    <span><?= $escaper->escapeHtml(__('Type of business')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="tc_cert_businesstype" class="admin__control-select" data-field="businessType">
