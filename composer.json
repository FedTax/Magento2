{
  "name": "taxcloud/magento2",
  "description": "TaxCloud Module for Magento 2",
  "type": "magento2-module",
  "version": "1.5.1",
  "license": "OSL-3.0",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Taxcloud\\Magento2\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^40",
    "phpstan/phpstan": "^1.12"
  },
  "archive": {
    "exclude": [
      ".gitignore",
      ".gitattributes",
      ".github/",
      ".cursorrules",
      ".cursor/",
      ".claude/",
      ".env",
      ".env.example",
      "Test/",
      "Makefile",
      "scripts/",
      "docs/",
      "mkdocs.yml",
      "CLAUDE.md",
      "openspec/",
      "docker-compose.yml",
      "docker-compose.e2e.yml",
      "phpunit.xml.dist",
      "phpunit.integration.xml.dist",
      "phpcs.xml.dist",
      "phpstan.neon",
      "phpstan-baseline.neon",
      "phpstan-bootstrap.php"
    ]
  }
}
