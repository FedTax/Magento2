# ─────────────────────────────────────────────────────────────────────────────
# PHPStan baseline — level 5.  Regenerated 2026-08-31 against Magento 2.4.9 /
# PHP 8.5 (the pinned CI version — see .github/workflows/test.yml).
#
# The type-imprecision bucket was burned down with the 1.4.0 REST migration;
# what remains are tooling limits only, safe to keep: Magento's
# FactoryGenerator stub shadows the real ClientFactory::create() signature,
# and Monolog\Logger is @final but Magento modules conventionally extend it.
#
# New code must pass clean — do not append to this file to silence fresh
# findings; fix them. Regenerate after reducing findings:
#   MAGENTO_ROOT=<root> vendor/bin/phpstan analyse -c phpstan.neon \
#     --memory-limit=1G --generate-baseline=phpstan-baseline.neon
# ─────────────────────────────────────────────────────────────────────────────
parameters:
	ignoreErrors:
		-
			message: "#^Class Taxcloud\\\\Magento2\\\\Logger\\\\Logger extends @final class Monolog\\\\Logger\\.$#"
			count: 1
			path: Logger/Logger.php

		-
			message: "#^Method Magento\\\\Framework\\\\Webapi\\\\Soap\\\\ClientFactory\\:\\:create\\(\\) invoked with 2 parameters, 0\\-1 required\\.$#"
			count: 1
			path: Model/Gateway/Soap/SoapGateway.php

		-
			message: "#^Parameter \\#1 \\$data of method Magento\\\\Framework\\\\Webapi\\\\Soap\\\\ClientFactory\\:\\:create\\(\\) expects array, string given\\.$#"
			count: 1
			path: Model/Gateway/Soap/SoapGateway.php