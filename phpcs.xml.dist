<?xml version="1.0"?>
<ruleset name="TaxCloud Magento2">
    <description>Coding standard for the TaxCloud Magento 2 module: magento/magento-coding-standard.</description>

    <!-- Same production scope as phpstan.neon. Test/ is intentionally absent: unit
         tests use partial mocks and doubles that deliberately bend Magento
         signatures, and this gate is about shipped code. -->
    <file>Api</file>
    <file>Logger</file>
    <file>Model</file>
    <file>Observer</file>
    <file>Plugin</file>
    <file>Setup</file>
    <file>registration.php</file>

    <!-- PHP only. The Magento2 standard also sniffs xml/less/js, but this module's
         non-PHP files are out of scope for this gate (and its CSS/JS sniffs are
         deprecated in PHP_CodeSniffer 3.9+, removed in 4.0). -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <!-- s = show sniff codes, so a CI failure names the rule to fix or exclude. -->
    <arg value="sp"/>

    <!-- The Magento2 standard reports everything as a warning (severity 6) rather
         than an error, so CI gates on warnings too — see README "Coding standard".
         Without that, this ruleset could never fail a build. -->
    <rule ref="Magento2">
        <!-- Non-PHP sniffs. Unreachable given the PHP-only scan above, but they still
             register CSS/GraphQL tokenizers, which emits a wall of "DEPRECATED:
             Scanning CSS/JS files is deprecated" notices on every run. Excluded to
             keep the output readable. -->
        <exclude name="Magento2.Less"/>
        <exclude name="Magento2.GraphQL"/>
        <exclude name="Squiz.CSS"/>

        <!-- Deferred — see the burn-down block below. 57 findings across 18 files, too
             diffuse to scope by file, so this is excluded standard-wide. -->
        <exclude name="Magento2.Annotation"/>
    </rule>

    <!-- ====================================================================
         Deferred sniffs. Everything below is a known, time-boxed exception —
         the same tactical approach as phpstan-baseline.neon, to burn down
         during the REST migration. Scoped to a file wherever the findings are
         confined to one, so new code is still held to the rule.

         Magento2.Annotation (57, excluded above): PHPDoc *formatting* nits — short
         description on one line, blank line before tags, @param visual alignment —
         rather than missing documentation. The module declares native PHP 8.2
         parameter/return types, so these docblocks largely restate the signatures
         they annotate; low value relative to the churn.
         ==================================================================== -->

    <!-- 16 findings: print_r($x, true) building debug strings passed to the logger
         (Model/Api.php), and stream_context_create() constructing the SOAP client
         context (SoapGateway.php). Both are legitimate here — the sniff targets
         print_r()-as-output, not as a string builder. Both files are SOAP-era code
         the REST migration replaces. -->
    <rule ref="Magento2.Functions.DiscouragedFunction">
        <exclude-pattern>Model/Api\.php$</exclude-pattern>
        <exclude-pattern>Model/Gateway/Soap/SoapGateway\.php$</exclude-pattern>
    </rule>

    <!-- 2 findings: pure static string helpers with no collaborators. The sniff's
         rationale is that static methods cannot be intercepted by a plugin; there is
         nothing here a plugin would want to intercept. -->
    <rule ref="Magento2.Functions.StaticFunction">
        <exclude-pattern>Model/PostalCodeParser\.php$</exclude-pattern>
    </rule>

    <!-- 1 finding: stream_context_create() flagged as an unguarded system-resource
         call. It allocates no handle that needs closing, so the try/catch the sniff
         wants would have no body to protect. SOAP-era code. -->
    <rule ref="Magento2.Exceptions.TryProcessSystemResources">
        <exclude-pattern>Model/Gateway/Soap/SoapGateway\.php$</exclude-pattern>
    </rule>
</ruleset>
